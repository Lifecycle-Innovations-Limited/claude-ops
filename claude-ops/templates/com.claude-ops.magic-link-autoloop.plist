<?xml version="1.0" encoding="UTF-8"?>
<!--
  Magic-link autoloop reconciler (opt-in unattended re-auth for confirmed
  dead-refresh-token accounts).

  Schedule: every 600s. Equivalent systemd: OnUnitActiveSec=600s.
  The installer (scripts/install-crs-reconcilers-agent.sh) substitutes
  __WRAPPER_PATH__, __LOG_DIR__, __HOME__, __PATH__, __DISPLAY__ from the
  host environment (no hardcoded package-manager paths in the template) and
  writes the rendered copy to ~/Library/LaunchAgents/ before:
    launchctl bootstrap "gui/$(id -u)" <plist>

  To uninstall:
    launchctl bootout "gui/$(id -u)/com.claude-ops.magic-link-autoloop"
    rm ~/Library/LaunchAgents/com.claude-ops.magic-link-autoloop.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.claude-ops.magic-link-autoloop</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__WRAPPER_PATH__</string>
  </array>

  <key>StartInterval</key>
  <integer>600</integer>

  <key>ThrottleInterval</key>
  <integer>60</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__LOG_DIR__/magic-link-autoloop-launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/magic-link-autoloop-launchd.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- Installer should expand PATH from the host; keep template free of OS package roots. -->
    <key>PATH</key>
    <string>__PATH__</string>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>NODE_NO_WARNINGS</key>
    <string>1</string>
    <!-- Unattended reauth seat (override per host via unit drop-in if needed) -->
    <key>CLAUDE_ROT_HEADED</key>
    <string>1</string>
    <key>CLAUDE_DESKTOP_DISPLAY</key>
    <string>__DISPLAY__</string>
    <key>DESKTOP_ACT_DISPLAY</key>
    <string>__DISPLAY__</string>
    <key>CLAUDE_ROT_VISUAL_CAPTCHA</key>
    <string>1</string>
    <key>CLAUDE_ROT_DESKTOP_ACT</key>
    <string>1</string>
    <key>CLAUDE_ROT_VNC_AGENT</key>
    <string>1</string>
    <key>CRS_MAGIC_LINK_ROTATE_TIMEOUT_MS</key>
    <string>1200000</string>
    <key>CLAUDE_ROT_SKIP_TOKEN_SOLVERS</key>
    <string>0</string>
  </dict>

  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
