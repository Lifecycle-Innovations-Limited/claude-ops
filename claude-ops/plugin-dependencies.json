      "marketplaceAdd": null,
      "installCli": null,
      "updateCli": null,
      "installScript": "scripts/install-gstack-companion.sh",
      "sameMarketplaceAsOps": false,
      "required": true,
      "coInstallDefault": true,
      "updateWithOps": "always",
      "prefsKey": "plugins.gstack",
      "detect": {
        "pathExists": ["${HOME}/.claude/skills/gstack/SKILL.md", "${HOME}/.agents/skills/gstack/SKILL.md"]
