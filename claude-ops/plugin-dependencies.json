      "essentialFor": ["/ops:flow (ad-hoc mode)", "/spec", "/review", "/qa", "/ship", "/browse"],
      "reason": "Stateless dev-lifecycle skills for /ops:flow ad-hoc mode (not a Claude marketplace plugin — git skills clone)"
    },
    {
      "name": "superpowers",
      "kind": "claude-plugin",
      "marketplaceId": "superpowers-marketplace",
      "marketplaceAdd": "obra/superpowers-marketplace",
      "installCli": "claude plugin install superpowers@superpowers-marketplace",
      "updateCli": "claude plugin update superpowers@superpowers-marketplace",
      "sameMarketplaceAsOps": false,
      "required": true,
      "coInstallDefault": true,
      "updateWithOps": "always",
