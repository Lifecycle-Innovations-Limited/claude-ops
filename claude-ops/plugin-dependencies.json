{
  "_comment": "SSOT for companion plugins + skills clones. Read by scripts/install-companions.sh and bin/ops-update. No host paths, no personal data. required=true means co-install on setup and always install/update with ops-update (unless --no-companions / OPS_SKIP_COMPANIONS=1). essentialFor lists the ops commands that break or hollow-out without the companion.",
  "marketplace": "ops-marketplace",
  "companions": [
    {
      "name": "desktop-act",
      "kind": "claude-plugin",
      "marketplaceId": "ops-marketplace",
      "marketplaceAdd": null,
      "installCli": "claude plugin install desktop-act@ops-marketplace",
      "updateCli": "claude plugin update desktop-act@ops-marketplace",
      "installScript": "scripts/install-desktop-act-companion.sh",
      "sameMarketplaceAsOps": true,
      "required": true,
      "coInstallDefault": true,
      "updateWithOps": "always",
      "userConfigGate": "desktop_act_co_install",
      "prefsKey": "plugins.desktop_act",
      "detect": { "find": "*/desktop-act/*plugin.json" },
      "essentialFor": ["/ops:desktop", "unattended captcha cascade (rotate-magic)"],
      "reason": "MCP companion for /ops:desktop and unattended captcha cascade"
    },
    {
      "name": "gsd",
      "kind": "claude-plugin",
      "marketplaceId": "gsd-build-get-shit-done",
      "marketplaceAdd": "gsd-build/get-shit-done",
      "installCli": "claude plugin install gsd@gsd-build-get-shit-done",
      "installScript": "scripts/install-gsd-companion.sh",
      "sameMarketplaceAsOps": false,
      "required": true,
      "coInstallDefault": true,
      "updateWithOps": "always",
      "prefsKey": "plugins.gsd",
      "detect": { "find": "*/skills/gsd-progress*" },
      "essentialFor": ["/ops:flow (project mode)", "/ops:projects", "/ops:go GSD sections", "/ops:next GSD priority"],
      "reason": "Project roadmap phases for /ops:flow project mode, /ops:go, and /ops:projects"
    },
    {
      "name": "gstack",
