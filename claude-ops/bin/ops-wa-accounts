#!/usr/bin/env python3
# ops-wa-accounts — resolve every whatsmeow bridge on this box to an account.
#
# Why this exists: more than one bridge can run at once, one per phone number.
# They differ only by port and store directory, and the lowest port answers
# first. Code that hardcodes 127.0.0.1:8080 therefore reads, archives and sends
# on whichever account happens to sit on the low port — which is how a full
# inbox run once replied to everyone from the wrong number.
#
# Nothing here guesses. An account is usable by an agent only when policy says
# so, and when exactly one such account exists. Two candidates with no policy is
# an error, not a coin flip.
#
# Usage:
#   ops-wa-accounts                 # JSON: every discovered account
#   ops-wa-accounts --list          # human-readable table
#   ops-wa-accounts --default       # "<port>\t<store>\t<phone>" for the one
#                                   # agent-enabled account; exit 3 if unclear
#   ops-wa-accounts --port          # just the port of that account
#   ops-wa-accounts --store         # just the messages.db of that account
#
# Account policy (never committed — it holds real numbers). /ops:setup writes
# it. Later files overlay earlier:
#   1. ~/.config/whatsapp/agent-policy.json          (legacy)
#   2. $OPS_DATA_DIR/registry.json  .whatsapp        (gitignored)
#   3. $PREFS_PATH  .channels.whatsapp               (plugin data dir; wins)
#
#   {
#     "default_agent_enabled": true,
#     "accounts": {
#       "<e164>": {
#         "label": "personal",
#         "agent_enabled": true,
#         "api": "http://127.0.0.1:<proxy-port>",
#         "bridge_port": "<proxy-port>",
#         "ssh": "user@bridge-host",
#         "remote_store": "/path/on/host/store/messages.db"
#       }
#     }
#   }
#
# Bridges may run on another host. This machine is then a client: `api` is the
# local reverse-proxy URL (never a remote IP, never a guessed :8080).
# `bridge_port` is that local listen port. A store path is optional; a client
# box often has no local messages.db. Template: scripts/registry.example.json.
#
# Exit codes: 0 ok · 3 no single agent-enabled account · 4 nothing discovered.

import argparse
import glob
import json
import os
import re
import sqlite3
import sys
from urllib.parse import urlparse

HOME = os.path.expanduser("~")
BRIDGE_GLOB = os.environ.get(
    "WHATSAPP_BRIDGE_GLOB", os.path.join(HOME, ".local/share/whatsapp-mcp/whatsapp-bridge*")
)
POLICY_PATH = os.environ.get(
    "WHATSAPP_AGENT_POLICY", os.path.join(HOME, ".config/whatsapp/agent-policy.json")
)
DEFAULT_BRIDGE_PORT = 8080  # whatsmeow's own default when WA_PORT is unset


def _data_dir():
    return os.environ.get(
        "CLAUDE_PLUGIN_DATA_DIR",
        os.path.join(HOME, ".claude/plugins/data/ops-ops-marketplace"),
    )


def _prefs_path():
    return os.environ.get("PREFS_PATH") or os.path.join(_data_dir(), "preferences.json")


def _registry_path():
    data = os.environ.get("OPS_DATA_DIR") or _data_dir()
    return os.environ.get("OPS_REGISTRY") or os.path.join(data, "registry.json")

# `export WA_PHONE="${WA_PHONE:-31612345678}"` and friends.
_DEFAULT_RE = r'{0}=(?:"|\')?\$\{{{0}:-([^}}]*)\}}'
# A plain `WA_PORT=8082` line in an env file.
_PLAIN_RE = r'^\s*(?:export\s+)?{0}=(?:"|\')?([^"\'\s#]+)'


def _scan(text, var):
    """Value of var from a shell snippet: ${VAR:-default} first, then VAR=x."""
    m = re.search(_DEFAULT_RE.format(var), text)
    if m and m.group(1).strip():
        return m.group(1).strip()
    m = re.search(_PLAIN_RE.format(var), text, re.M)
    if m and m.group(1).strip():
        return m.group(1).strip()
    return None


def _sourced_env_files(text):
    """Env files the launcher sources, so their values can override defaults."""
    out = []
    for m in re.finditer(r'^\s*(?:\.|source)\s+"?([^"\s]+)"?', text, re.M):
        p = m.group(1).replace("$HOME", HOME).replace("${HOME}", HOME)
        out.append(os.path.expanduser(p))
    return out


def _paired_jid(store_dir):
    """The number actually paired in the store — ground truth, unlike config."""
    db = os.path.join(store_dir, "whatsapp.db")
    if not os.path.exists(db):
        return None
    try:
        con = sqlite3.connect("file:%s?mode=ro" % db, uri=True, timeout=2.0)
        try:
            row = con.execute("SELECT jid FROM whatsmeow_device LIMIT 1").fetchone()
        finally:
            con.close()
    except sqlite3.Error:
        return None
    if not row or not row[0]:
        return None
    return str(row[0]).split(":", 1)[0].split("@", 1)[0] or None


def _read_json(path):
    try:
        with open(path) as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return None
    return data if isinstance(data, dict) else None


def _accounts_from_blob(blob):
    """Return (accounts_map, default_agent_enabled) from a policy-shaped dict."""
    if not isinstance(blob, dict):
        return {}, None
    if isinstance(blob.get("accounts"), dict):
        return dict(blob["accounts"]), blob.get("default_agent_enabled")
    values = list(blob.values())
    if values and all(isinstance(v, dict) for v in values):
        sample = values[0]
        if any(k in sample for k in ("api", "bridge_port", "agent_enabled", "ssh", "remote_store")):
            return dict(blob), None
    return {}, None


def _merge_account_maps(base, overlay):
    out = dict(base or {})
    for phone, rule in (overlay or {}).items():
        if not isinstance(rule, dict):
            continue
        phone = str(phone)
        if phone in out and isinstance(out[phone], dict):
            merged = dict(out[phone])
            merged.update(rule)
            out[phone] = merged
        else:
            out[phone] = dict(rule)
    return out


def _load_policy():
    """Merge WhatsApp accounts from legacy policy, registry, then prefs (wins)."""
    accounts = {}
    policy_default = None

    pol = _read_json(POLICY_PATH)
    if pol is not None:
        a, d = _accounts_from_blob(pol)
        accounts = _merge_account_maps(accounts, a)
        if d is not None:
            policy_default = d

    reg = _read_json(_registry_path())
    if reg is not None and isinstance(reg.get("whatsapp"), dict):
        a, d = _accounts_from_blob(reg["whatsapp"])
        accounts = _merge_account_maps(accounts, a)
        if d is not None:
            policy_default = d

    prefs = _read_json(_prefs_path())
    if prefs is not None:
        channels = prefs.get("channels") if isinstance(prefs.get("channels"), dict) else {}
        wa = channels.get("whatsapp")
        if wa is None:
            wa = prefs.get("whatsapp")
        if isinstance(wa, dict):
            a, d = _accounts_from_blob(wa)
            accounts = _merge_account_maps(accounts, a)
            if d is not None:
                policy_default = d

    return accounts, policy_default, None


def discover():
    accounts, policy_default, policy_note = _load_policy()
    notes = []
    if policy_note:
        notes.append(policy_note)

    found = []
    for d in sorted(glob.glob(BRIDGE_GLOB)):
        if not os.path.isdir(d):
            continue
        store = os.path.join(d, "store")
        msgdb = os.path.join(store, "messages.db")
        if not os.path.exists(msgdb):
            continue  # a bridge dir without a store is not a usable account

        launcher = os.path.join(d, "run-bridge.sh")
        text = ""
        if os.path.exists(launcher):
            try:
                with open(launcher) as fh:
                    text = fh.read()
            except OSError:
                text = ""

        phone_cfg = _scan(text, "WA_PHONE")
        port = _scan(text, "WA_PORT")
        # An env file sourced with `set -a` overrides the launcher defaults.
        for env_path in _sourced_env_files(text):
            if not os.path.exists(env_path):
                continue
            try:
                with open(env_path) as fh:
                    env_text = fh.read()
            except OSError:
                continue
            phone_cfg = _scan(env_text, "WA_PHONE") or phone_cfg
            port = _scan(env_text, "WA_PORT") or port

        try:
            port = int(port) if port else DEFAULT_BRIDGE_PORT
        except ValueError:
            port = DEFAULT_BRIDGE_PORT

        phone_paired = _paired_jid(store)
        phone = phone_paired or phone_cfg

        rule = accounts.get(phone) if phone else None
        if rule is None and phone_cfg and phone_cfg != phone:
            rule = accounts.get(phone_cfg)
        if rule is None:
            enabled = policy_default
            reason = "policy default" if enabled is not None else "no policy entry"
        else:
            enabled = rule.get("agent_enabled", True)
            reason = rule.get("note") or "policy entry"

        acct = {
            "label": os.path.basename(d),
            "dir": d,
            "store": msgdb,
            "port": port,
            "api": "http://127.0.0.1:%d" % port,
            "phone": phone,
            "phone_configured": phone_cfg,
            "phone_paired": phone_paired,
            "agent_enabled": bool(enabled) if enabled is not None else None,
            "policy_reason": reason,
        }
        # The launcher claiming one number while the store is paired to another
        # is exactly the trap this tool exists to catch.
        if phone_cfg and phone_paired and phone_cfg != phone_paired:
            acct["mismatch"] = (
                "run-bridge.sh says %s but the store is paired to %s — trust the store"
                % (phone_cfg, phone_paired)
            )
            notes.append("%s: %s" % (acct["label"], acct["mismatch"]))
        found.append(acct)

    found = _merge_policy_clients(found, accounts, policy_default, notes)

    enabled = [a for a in found if a["agent_enabled"] is True]
    unknown = [a for a in found if a["agent_enabled"] is None]

    default = None
    if len(enabled) == 1:
        default = enabled[0]
    elif len(enabled) > 1:
        notes.append(
            "%d accounts are agent-enabled (%s) — pass --wa-store/--bridge-port explicitly"
            % (len(enabled), ", ".join(a["phone"] or a["label"] for a in enabled))
        )
    elif len(found) == 1 and unknown:
        # One bridge and no policy: unambiguous, so using it is not a guess.
        default = found[0]
        notes.append("single bridge and no policy — using %s" % found[0]["label"])
    elif unknown:
        notes.append(
            "%d accounts have no policy entry — write channels.whatsapp.accounts "
            "in %s (or %s) before agents touch them"
            % (len(unknown), _prefs_path(), POLICY_PATH)
        )

    return {
        "accounts": found,
        "default": default,
        "notes": notes,
        "policy": _prefs_path(),
        "policy_sources": {
            "prefs": _prefs_path(),
            "registry": _registry_path(),
            "legacy": POLICY_PATH,
        },
    }


def _port_from_api(api):
    if not api:
        return None
    try:
        p = urlparse(api)
        if p.port:
            return int(p.port)
    except ValueError:
        return None
    return None


def _merge_policy_clients(found, accounts_pol, policy_default, notes):
    """Overlay policy `api`/`bridge_port` and add client-only accounts.

    A box can have no local whatsmeow store (the bridge runs on another host).
    Policy then carries the local reverse-proxy URL the agent must dial.
    Policy port/api always wins over a leftover local store's launcher port.
    """
    by_phone = {}
    for a in found:
        if a.get("phone"):
            by_phone[str(a["phone"])] = a

    for phone, rule in (accounts_pol or {}).items():
        if not isinstance(rule, dict):
            continue
        phone = str(phone)
        api = (rule.get("api") or "").rstrip("/")
        port = rule.get("bridge_port") or rule.get("caddy_port")
        try:
            port = int(port) if port is not None else _port_from_api(api)
        except (TypeError, ValueError):
            port = _port_from_api(api)
        store = rule.get("store") or ""
        if not api and port:
            api = "http://127.0.0.1:%d" % port
        if not api and not port and not store:
            continue
        enabled = rule.get("agent_enabled", policy_default)
        reason = rule.get("note") or "policy client"

        existing = by_phone.get(phone)
        ssh = (rule.get("ssh") or "").strip()
        ssh_fallback = (rule.get("ssh_fallback") or "").strip()
        remote_store = (rule.get("remote_store") or "").strip()
        if existing:
            if port:
                existing["port"] = port
            if api:
                existing["api"] = api
            if store:
                existing["store"] = store
            if ssh:
                existing["ssh"] = ssh
            if ssh_fallback:
                existing["ssh_fallback"] = ssh_fallback
            if remote_store:
                existing["remote_store"] = remote_store
            existing["policy_reason"] = reason
            if enabled is not None:
                existing["agent_enabled"] = bool(enabled)
            continue

        found.append({
            "label": rule.get("label") or phone,
            "dir": "",
            "store": store,
            "port": port or 0,
            "api": api or "",
            "ssh": ssh,
            "ssh_fallback": ssh_fallback,
            "remote_store": remote_store,
            "phone": phone,
            "phone_configured": phone,
            "phone_paired": None,
            "agent_enabled": bool(enabled) if enabled is not None else None,
            "policy_reason": reason,
        })
        by_phone[phone] = found[-1]
        notes.append("policy client %s → %s" % (phone, api or store or ("port %s" % port)))
    return found


def main():
    ap = argparse.ArgumentParser(add_help=True, description=__doc__)
    g = ap.add_mutually_exclusive_group()
    g.add_argument("--list", action="store_true", help="human-readable table")
    g.add_argument("--default", action="store_true", help="port, store and phone of the agent account")
    g.add_argument("--port", action="store_true", help="port of the agent account")
    g.add_argument("--store", action="store_true", help="messages.db of the agent account")
    args = ap.parse_args()

    res = discover()

    if args.list:
        if not res["accounts"]:
            print(
                "no WhatsApp accounts in %s, %s, or %s"
                % (_prefs_path(), _registry_path(), POLICY_PATH),
                file=sys.stderr,
            )
            return 4
        print("%-24s %-6s %-16s %-8s %s" % ("BRIDGE", "PORT", "PHONE", "AGENT", "API/STORE"))
        for a in res["accounts"]:
            state = {True: "yes", False: "NO", None: "unset"}[a["agent_enabled"]]
            loc = a.get("api") or a.get("store") or ""
            print("%-24s %-6s %-16s %-8s %s" % (a["label"], a.get("port") or "-", a["phone"] or "?", state, loc))
        for n in res["notes"]:
            print("note: %s" % n, file=sys.stderr)
        return 0

    if args.default or args.port or args.store:
        d = res["default"]
        if not d:
            for n in res["notes"]:
                print("ops-wa-accounts: %s" % n, file=sys.stderr)
            print(
                "ops-wa-accounts: no single agent-enabled account — refusing to guess",
                file=sys.stderr,
            )
            return 3 if res["accounts"] else 4
        if args.port:
            print(d["port"])
        elif args.store:
            print(d["store"])
        else:
            print("%d\t%s\t%s" % (d["port"], d["store"], d["phone"] or ""))
        return 0

    json.dump(res, sys.stdout, indent=2)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
