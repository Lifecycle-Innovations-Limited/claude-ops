#!/usr/bin/env bash
# ops-credentials — Audit which integration credentials are configured.
#
# For each integration the plugin knows about, scans every credential source
# (shell env, ops preferences.json, Doppler if configured, macOS Keychain)
# and reports configured-vs-missing with a masked
# preview of any value found.
#
# Output modes:
#   ops-credentials              # human-readable table
#   ops-credentials --json       # JSON array for programmatic use
#   ops-credentials --service X  # only check service X
#
# Never prints raw credential values. Mask format: first 6 chars + "•••" +
# last 4 chars. Values shorter than 12 chars print as "•••".

set -euo pipefail

IS_MACOS=false
[[ "$(uname -s)" = "Darwin" ]] && IS_MACOS=true

OPS_DATA_DIR="${OPS_DATA_DIR:-${CLAUDE_PLUGIN_DATA_DIR:-$HOME/.claude/plugins/data/ops-ops-marketplace}}"
PREFS="$OPS_DATA_DIR/preferences.json"

OUTPUT_MODE="text"
SERVICE_FILTER=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --json) OUTPUT_MODE="json"; shift ;;
    --service) SERVICE_FILTER="$2"; shift 2 ;;
    -h|--help)
      sed -n '2,15p' "$0" | sed 's/^# \?//'
      exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

# ─── credential catalog ───────────────────────────────────────────────────
# service|label|env_var|prefs_jq_path|keychain_service|legacy_unused|user_config_path
read -r -d '' CATALOG <<'CATEOF' || true
telegram|Telegram (api_hash)|TELEGRAM_API_HASH|.telegram.api_hash|telegram-api-hash|telegram|.user_config.telegram_api_hash
telegram|Telegram (session)|TELEGRAM_SESSION||telegram-session|telegram|.user_config.telegram_session
slack|Slack (xoxc)|SLACK_MCP_XOXC_TOKEN||slack-xoxc|slack|
slack|Slack (xoxd)|SLACK_MCP_XOXD_TOKEN||slack-xoxd|slack|
discord|Discord bot token|DISCORD_BOT_TOKEN|.discord.bot_token||discord|.user_config.discord_bot_token
discord|Discord webhook|DISCORD_WEBHOOK_URL|.discord.default_webhook_url||discord|.user_config.discord_default_webhook_url
pushover|Pushover user key|PUSHOVER_USER|.pushover_user_key|pushover-user|pushover|.user_config.pushover_user_key
pushover|Pushover app token|PUSHOVER_TOKEN|.pushover_app_token|pushover-app|pushover|.user_config.pushover_app_token
sentry|Sentry auth token|SENTRY_AUTH_TOKEN||sentry-auth-token|sentry|
linear|Linear API key|LINEAR_API_KEY||linear-api-key|linear|
datadog|Datadog API key|DATADOG_API_KEY|.datadog.api_key||datadog|.user_config.datadog_api_key
datadog|Datadog app key|DATADOG_APP_KEY|.datadog.app_key||datadog|.user_config.datadog_app_key
newrelic|New Relic API key|NEW_RELIC_API_KEY|.newrelic.api_key||newrelic|.user_config.newrelic_api_key
doppler|Doppler service token|DOPPLER_TOKEN|.doppler.service_token||doppler|.user_config.doppler_token
klaviyo|Klaviyo private key|KLAVIYO_API_KEY|.marketing.klaviyo.api_key|klaviyo-api-key|klaviyo|.user_config.klaviyo_private_key
meta_ads|Meta Ads access token|META_ACCESS_TOKEN|.marketing.meta.access_token||meta|.user_config.meta_ads_token
shopify|Shopify admin token|SHOPIFY_ACCESS_TOKEN|.ecom.shopify.admin_token|shopify-admin-token|shopify|.user_config.shopify_admin_token
shipbob|ShipBob access token|SHIPBOB_ACCESS_TOKEN|.ecom.partners.shipbob.credentials.api_token||shipbob|.user_config.shipbob_access_token
bland_ai|Bland AI API key|BLAND_AI_API_KEY|.voice.bland.api_key|bland-ai-api-key|bland|.user_config.bland_ai_api_key
elevenlabs|ElevenLabs API key|ELEVENLABS_API_KEY|.voice.elevenlabs.api_key|elevenlabs-api-key|elevenlabs|.user_config.elevenlabs_api_key
groq|Groq API key|GROQ_API_KEY|.voice.groq.api_key|groq-api-key|groq|.user_config.groq_api_key
stripe|Stripe secret key|STRIPE_SECRET_KEY|.revenue.stripe.secret_key|stripe-secret-key|stripe|.user_config.stripe_secret_key
revenuecat|RevenueCat API key|REVENUECAT_API_KEY|.revenue.revenuecat.api_key|revenuecat-api-key|revenuecat|.user_config.revenuecat_api_key
postnl|PostNL customer code|POSTNL_CUSTOMER_CODE|.shipping.postnl.customer_code||postnl|.user_config.postnl_customer_code
dpd|DPD password|DPD_PASSWORD|.shipping.dpd.password||dpd|.user_config.dpd_password
ups|UPS client secret|UPS_CLIENT_SECRET|.shipping.ups.client_secret||ups|.user_config.ups_client_secret
fedex|FedEx client secret|FEDEX_CLIENT_SECRET|.shipping.fedex.client_secret||fedex|.user_config.fedex_client_secret
CATEOF

# ─── helpers ──────────────────────────────────────────────────────────────
mask() {
  local v="${1:-}"
  local len=${#v}
  if [[ $len -eq 0 ]]; then printf ''
  elif [[ $len -lt 12 ]]; then printf '•••'
  else printf '%s•••%s' "${v:0:6}" "${v: -4}"
  fi
}

# Only nonempty strings are credentials; objects, booleans and templates are not.
pref_get() {
  [[ -f "$PREFS" ]] || return 0
  jq -r "$1 | select(type == \"string\") | select(length > 0) | select(startswith(\"\u0024{\") | not)" "$PREFS" 2>/dev/null || true
}

# Resolve only the named reference. Never enumerate vaults or infer API keys
# from website passwords. A reference is not proof that a value is available.
resolve_ref() {
  local v="$1" src="$2" key="" project="" config="" rest="" resolved=""
  local -a scope=()
  case "$v" in
    env:*)
      key="${v#env:}"
      if [[ "$key" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]]; then
        resolved="${!key:-}"
      fi
      ;;
    doppler:*)
      rest="${v#doppler:}"
      project=$(pref_get '.doppler.project // .user_config.doppler_project')
      config=$(pref_get '.doppler.config // .user_config.doppler_config')
      case "$rest" in
        */*)
          project="${rest%%/*}"; rest="${rest#*/}"
          config="${rest%%/*}"; key="${rest#*/}"
          [[ "$rest" == */* && -n "$project" && -n "$config" ]] || key=""
          ;;
        *:*) config="${rest%%:*}"; key="${rest#*:}"
          [[ -n "$config" ]] || key="" ;;
        *) key="$rest" ;;
      esac
      if [[ "$key" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ &&
            "$project" =~ ^[a-zA-Z0-9_-]*$ && "$config" =~ ^[a-zA-Z0-9_-]*$ ]] && command -v doppler >/dev/null 2>&1; then
        [[ -z "$project" ]] || scope+=(--project "$project")
        [[ -z "$config" ]] || scope+=(--config "$config")
        # A failing command may still print partial stdout: discard it.
        if ! resolved=$(doppler secrets get "$key" --plain ${scope[@]+"${scope[@]}"} </dev/null 2>/dev/null); then resolved=""; fi
      fi
      ;;
    *) printf '%s|%s' "$v" "$src"; return ;;
  esac
  if [[ -n "$resolved" ]]; then
    printf '%s|%s' "$resolved" "$v"
  else
    # Do not echo malformed references (which may contain sensitive text).
    printf '|%s' "$src"
  fi
}

resolve() {
  local env_var="$1" prefs_path="$2" keychain_svc="$3" user_path="$5"
  local v="" path=""
  if [[ -n "$env_var" ]]; then
    v="${!env_var:-}"
    if [[ -n "$v" ]]; then resolve_ref "$v" "env:${env_var}"; return; fi
  fi
  # Keep legacy preferences ahead of the explicit setup/user_config mapping.
  if command -v jq >/dev/null 2>&1; then
    for path in "$prefs_path" "$user_path"; do
      [[ -n "$path" ]] || continue
      v=$(pref_get "$path")
      if [[ -n "$v" ]]; then resolve_ref "$v" "prefs:${path}"; return; fi
    done
  fi
  if $IS_MACOS && [[ -n "$keychain_svc" ]] && command -v security >/dev/null 2>&1; then
    v=$(security find-generic-password -s "$keychain_svc" -w </dev/null 2>/dev/null || true)
    if [[ -n "$v" ]]; then printf '%s|keychain:%s' "$v" "$keychain_svc"; return; fi
  fi
}

# ─── scan ─────────────────────────────────────────────────────────────────
results_json="[]"
configured=0
missing=0
declare -a configured_lines=()
declare -a missing_lines=()

# The catalog is read on fd 3, not stdin: resolve() shells out to doppler,
# security, and either may drain stdin. When the loop shared
# stdin with them, the first child swallowed the rest of the catalog and the
# audit stopped after a single service ("1 tracked services").
while IFS='|' read -r -u 3 service label env_var prefs_path keychain_svc dashlane_kw user_path; do
  [[ -z "$service" || "$service" == \#* ]] && continue
  if [[ -n "$SERVICE_FILTER" && "$service" != "$SERVICE_FILTER" ]]; then continue; fi

  found=$(resolve "$env_var" "$prefs_path" "$keychain_svc" "$dashlane_kw" "$user_path")
  if [[ -n "$found" && "$found" != \|* ]]; then
    value="${found%|*}"
    src="${found##*|}"
    masked=$(mask "$value")
    configured=$((configured+1))
    configured_lines+=("$(printf '  ✓ %-32s %-22s %s' "$label" "$masked" "($src)")")
    if [[ "$OUTPUT_MODE" == "json" ]]; then
      results_json=$(jq -c --arg s "$service" --arg l "$label" --arg m "$masked" --arg src "$src" \
        '. + [{service:$s, label:$l, configured:true, masked:$m, source:$src}]' <<<"$results_json")
    fi
  else
    missing=$((missing+1))
    unresolved_note=""
    if [[ "$found" == \|* ]]; then unresolved_note=" (unresolved reference)"; fi
    missing_lines+=("$(printf '  ✗ %-32s — run /ops:setup %s%s' "$label" "$service" "$unresolved_note")")
    if [[ "$OUTPUT_MODE" == "json" ]]; then
      results_json=$(jq -c --arg s "$service" --arg l "$label" \
        '. + [{service:$s, label:$l, configured:false}]' <<<"$results_json")
      if [[ -n "$unresolved_note" ]]; then
        results_json=$(jq -c --arg src "${found#|}" '.[-1] += {status:"unresolved", source:$src}' <<<"$results_json")
      fi
    fi
  fi
done 3<<<"$CATALOG"

# ─── output ───────────────────────────────────────────────────────────────
if [[ "$OUTPUT_MODE" == "json" ]]; then
  echo "$results_json" | jq '.'
  exit 0
fi

# Mobile / SSH compact mode
COMPACT=0
if [[ -n "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" || "${OPS_MOBILE:-}" == "1" ]]; then COMPACT=1; fi

if [[ $COMPACT -eq 1 ]]; then
  echo "credentials: ${configured} configured, ${missing} missing"
  if [[ $configured -gt 0 ]]; then
    printf '%s\n' "${configured_lines[@]}" | sed 's/^  ✓ /✓ /'
  fi
  if [[ $missing -gt 0 ]]; then
    printf '%s\n' "${missing_lines[@]}" | sed 's/^  ✗ /✗ /'
  fi
  exit 0
fi

cat <<EOF
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
 OPS ► CREDENTIALS AUDIT
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
EOF

if [[ $configured -gt 0 ]]; then
  echo
  echo "Configured ($configured):"
  printf '%s\n' "${configured_lines[@]}"
fi

if [[ $missing -gt 0 ]]; then
  echo
  echo "Missing ($missing):"
  printf '%s\n' "${missing_lines[@]}"
fi

cat <<EOF

──────────────────────────────────────────────────────
 Total: $((configured + missing)) tracked services · $configured set · $missing pending
 Configure: /ops:setup <service-name>
 Re-audit:  /ops:credentials  (or  bin/ops-credentials --json)
──────────────────────────────────────────────────────
EOF
