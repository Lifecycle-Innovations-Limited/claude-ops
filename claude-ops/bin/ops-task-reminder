#!/usr/bin/env bash
# ops-task-reminder — PostToolUse hook on every tool.
# Per-session counter at $STATE_DIR/task-reminder-<sid>. When N non-Task tool calls
# occur without any Task* call, injects a system-reminder via additionalContext.
# Counter resets to 0 on any Task* tool use.
#
# The hook runs async (hooks.json), so several invocations for one session can
# overlap. The read-increment-write of the counter is therefore done under a
# per-session exclusive lock: flock(1) when the box has it, otherwise an atomic
# mkdir lock (macOS ships no flock). If the lock cannot be taken within ~2s the
# hook exits 0 with no output — a missed count is cheaper than a stuck hook.
#
# Test knobs: OPS_TASK_REMINDER_LOCK_IMPL=auto|flock|mkdir forces the lock
# strategy; OPS_TASK_REMINDER_LOCK_TIMEOUT overrides the 2s give-up;
# OPS_TASK_REMINDER_LOCK_WAIT overrides how long the mkdir lock keeps waiting
# while a live hook holds it (default = the give-up time). A separate wait is
# needed because an exact count must outlast a slow runner, while a lock held
# by a dead hook must still give up fast.
set -e
PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
. "$PLUGIN_ROOT/scripts/lib/deploy-fix-common.sh" 2>/dev/null || {
  STATE_DIR="$HOME/.claude/state/ops"
  mkdir -p "$STATE_DIR" 2>/dev/null
  config() { echo "${2:-}"; }
}

[ "$(config task_reminder_enabled true)" = "false" ] && exit 0
THRESHOLD=$(config task_reminder_threshold 10)

INPUT=$(cat)
sid=$(printf '%s' "$INPUT" | jq -r '.session_id // "default"' 2>/dev/null)
tool=$(printf '%s' "$INPUT" | jq -r '.tool_name // ""' 2>/dev/null)
# Subagents share the parent's session_id; Claude Code sets agent_id only for
# them. Count each agent separately so subagent calls never fill (or reset) the
# main thread's counter. Async hook output from a subagent is delivered to the
# parent's context, where TaskCreate may just have been used, so subagents
# count but never print the reminder.
aid=$(printf '%s' "$INPUT" | jq -r '.agent_id // ""' 2>/dev/null | tr -cd 'A-Za-z0-9_-')
state_file="$STATE_DIR/task-reminder-${sid}${aid:+-agent-$aid}"

# ── per-session lock ───────────────────────────────────────────────────────
LOCK_TIMEOUT_S="${OPS_TASK_REMINDER_LOCK_TIMEOUT:-2}"
LOCK_WAIT_S="${OPS_TASK_REMINDER_LOCK_WAIT:-$LOCK_TIMEOUT_S}"
LOCK_STALE_MIN=1 # a mkdir lock older than this belongs to a killed hook
lock_impl="${OPS_TASK_REMINDER_LOCK_IMPL:-auto}"
if [ "$lock_impl" = "auto" ]; then
  if command -v flock >/dev/null 2>&1; then lock_impl="flock"; else lock_impl="mkdir"; fi
fi

lock_dir=""
release_lock() {
  if [ -n "$lock_dir" ]; then rmdir "$lock_dir" 2>/dev/null || true; fi
}

acquire_lock() {
  if [ "$lock_impl" = "flock" ]; then
    exec 9>"${state_file}.flock" || return 1
    flock -w "$LOCK_TIMEOUT_S" 9 || return 1
    return 0
  fi
  # Two deadlines. LOCK_WAIT bounds how long a live hook may hold the lock
  # before this call gives up (exact counts need this long). LOCK_TIMEOUT
  # bounds only the stale-reclaim check: a lock left by a killed hook is
  # cleared once it is older than LOCK_STALE_MIN and the give-up time has
  # passed, so a dead lock never stalls the hook.
  local d="${state_file}.lockd" tries=0
  local wait_deadline=$((SECONDS + LOCK_WAIT_S))
  local stale_deadline=$((SECONDS + LOCK_TIMEOUT_S))
  while ! mkdir "$d" 2>/dev/null; do
    # Reclaim first, then give up. With equal defaults the stale check must
    # run before the wait deadline returns, or a dead lock is never cleared.
    if [ "$SECONDS" -ge "$stale_deadline" ] &&
      [ -n "$(find "$d" -maxdepth 0 -mmin +"$LOCK_STALE_MIN" 2>/dev/null)" ]; then
      rmdir "$d" 2>/dev/null || true
      continue
    fi
    [ "$SECONDS" -ge "$wait_deadline" ] && return 1
    tries=$((tries + 1))
    sleep 0.05
  done
  lock_dir="$d"
  trap release_lock EXIT
  return 0
}

acquire_lock || exit 0

# Reset on any Task* tool, including namespaced names such as
# "mcp__<server>__TaskUpdate": only the segment after the last "__" counts.
case "${tool##*__}" in
  Task*) echo 0 > "$state_file"; exit 0 ;;
esac

count=$(cat "$state_file" 2>/dev/null || echo 0)
count=$((count + 1))

if [ "$count" -ge "$THRESHOLD" ] && [ -n "$aid" ]; then
  echo 0 > "$state_file"
elif [ "$count" -ge "$THRESHOLD" ]; then
  echo 0 > "$state_file"
  cat <<JSON
{
  "suppressOutput": true,
  "hookSpecificOutput": {
    "hookEventName": "PostToolUse",
    "additionalContext": "[ops-task-reminder] No Task* tool used in the last $THRESHOLD calls. For multi-step work, consider TaskCreate to track open items, TaskUpdate to mark progress, TaskList to review status. Skip this reminder if your current work is a single quick action."
  }
}
JSON
else
  echo "$count" > "$state_file"
fi
exit 0
