#!/usr/bin/env bash
# ops-task-reminder — PostToolUse hook on every tool.
# Per-session counter at $STATE_DIR/task-reminder-<sid>. When N non-Task tool calls
# occur without any Task* call, injects a system-reminder via additionalContext.
# Counter resets to 0 on any Task* tool use.
#
# The hook runs async (hooks.json), so several invocations for one session can
# overlap. The read-increment-write of the counter is therefore done under a
# per-session exclusive lock: flock(1) when the box has it, otherwise
# scripts/lib/task-reminder-lock.py (python3, fcntl.flock on the same .flock
# file; macOS ships no flock). If the lock cannot be taken within ~2s the hook
# exits 0 with no output — a missed count is cheaper than a stuck hook. If
# neither flock nor python3 exists it says so on stderr and counts nothing.
#
# Rollout: pre-3.12.1 hooks used a .lockd mkdir lock that does not honour this
# kernel lock. Never run old and new hooks against one state dir at once; let
# in-flight hooks finish before updating.
#
# Test knobs: OPS_TASK_REMINDER_LOCK_IMPL=auto|flock|portable (mkdir is an
# alias of portable) forces the lock strategy; OPS_TASK_REMINDER_LOCK_TIMEOUT
# overrides the 2s wait; OPS_TASK_REMINDER_PYTHON overrides the python3 name.
set -e
PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
. "$PLUGIN_ROOT/scripts/lib/deploy-fix-common.sh" 2>/dev/null || {
  STATE_DIR="$HOME/.claude/state/ops"
  mkdir -p "$STATE_DIR" 2>/dev/null
  config() { echo "${2:-}"; }
}

[ "$(config task_reminder_enabled true)" = "false" ] && exit 0
THRESHOLD=$(config task_reminder_threshold 10)

INPUT=$(cat)
sid=$(printf '%s' "$INPUT" | jq -r '.session_id // "default"' 2>/dev/null)
tool=$(printf '%s' "$INPUT" | jq -r '.tool_name // ""' 2>/dev/null)
# Subagents share the parent's session_id; Claude Code sets agent_id only for
# them. Count each agent separately so subagent calls never fill (or reset) the
# main thread's counter. Async hook output from a subagent is delivered to the
# parent's context, where TaskCreate may just have been used, so subagents
# count but never print the reminder.
aid=$(printf '%s' "$INPUT" | jq -r '.agent_id // ""' 2>/dev/null | tr -cd 'A-Za-z0-9_-')
state_file="$STATE_DIR/task-reminder-${sid}${aid:+-agent-$aid}"

# ── per-session lock ───────────────────────────────────────────────────────
LOCK_TIMEOUT_S="${OPS_TASK_REMINDER_LOCK_TIMEOUT:-2}"
lock_impl="${OPS_TASK_REMINDER_LOCK_IMPL:-auto}"
case "$lock_impl" in mkdir) lock_impl="portable" ;; esac # pre-3.12.1 name
if [ "$lock_impl" = "auto" ]; then
  if command -v flock >/dev/null 2>&1; then lock_impl="flock"; else lock_impl="portable"; fi
fi

acquire_lock() {
  exec 9>"${state_file}.flock" || return 1
  flock -w "$LOCK_TIMEOUT_S" 9 || return 1
  return 0
}

if [ "$lock_impl" = "portable" ]; then
  # No flock(1) (macOS): python3 takes a real fcntl.flock() on the same
  # .flock file and runs the whole counter transaction while holding it.
  py="${OPS_TASK_REMINDER_PYTHON:-python3}"
  helper="$PLUGIN_ROOT/scripts/lib/task-reminder-lock.py"
  if ! command -v "$py" >/dev/null 2>&1 || [ ! -f "$helper" ]; then
    echo "ops-task-reminder: python3 (or $helper) not found and flock(1) is not installed; task reminder counting is OFF. Install python3 or flock." >&2
    exit 0
  fi
  is_agent=0
  [ -n "$aid" ] && is_agent=1
  # Fail-open: a broken interpreter (CLT stub, too-old python) must not make the hook fail.
  "$py" -I "$helper" "$state_file" "$THRESHOLD" "$LOCK_TIMEOUT_S" "$tool" "$is_agent" ||
    echo "ops-task-reminder: lock helper failed (exit $?); counting skipped" >&2
  exit 0
fi

acquire_lock || exit 0

# Reset on any Task* tool, including namespaced names such as
# "mcp__<server>__TaskUpdate": only the segment after the last "__" counts.
case "${tool##*__}" in
  Task*) echo 0 > "$state_file"; exit 0 ;;
esac

count=$(cat "$state_file" 2>/dev/null || echo 0)
count=$((count + 1))

if [ "$count" -ge "$THRESHOLD" ] && [ -n "$aid" ]; then
  echo 0 > "$state_file"
elif [ "$count" -ge "$THRESHOLD" ]; then
  echo 0 > "$state_file"
  cat <<JSON
{
  "suppressOutput": true,
  "hookSpecificOutput": {
    "hookEventName": "PostToolUse",
    "additionalContext": "[ops-task-reminder] No Task* tool used in the last $THRESHOLD calls. For multi-step work, consider TaskCreate to track open items, TaskUpdate to mark progress, TaskList to review status. Skip this reminder if your current work is a single quick action."
  }
}
JSON
else
  echo "$count" > "$state_file"
fi
exit 0
