#!/usr/bin/env python3
"""agent-log-rotate — bounded copy/truncate rotation for launchd service logs.

WHY COPY-TRUNCATE AND NOT RENAME
launchd opens a job's StandardOutPath/StandardErrorPath itself and hands the
process an fd. Renaming the file (what newsyslog and logrotate do by default)
leaves the service writing into the *renamed* file forever while the fresh one
stays empty at 0 bytes. So this copies the content out to a compressed archive
and then truncates the original IN PLACE, which keeps the inode and the fd
valid. Copy/truncate is BEST EFFORT, not lossless: the final unchanged-file
check and the truncate are separate syscalls, and launchd-owned writers do not
honor flock, so a line written in that window is lost. The window is kept as
small as possible and a change detected before truncation preserves the file.
Prefer producer-native rotation when available.

NOTHING IS EVER DELETED without an explicit --prune, and even then only
archives beyond --keep. Log retention must not be shortened during debugging, so the default keep
count is deliberately generous and `--prune` is opt-in.

Discovery is bounded: it reads launchd plists and rotates only paths those
plists actually name. It never walks the filesystem looking for logs.
"""

from __future__ import annotations

import argparse
import fcntl
import tempfile
import gzip
import os
import plistlib
import shutil
import subprocess
import sys
import time

PLIST_DIRS = [
    os.path.expanduser("~/Library/LaunchAgents"),
    "/Library/LaunchDaemons",
    "/Library/LaunchAgents",
]
ARCHIVE_SUBDIR = "rotated"


def human(n: float) -> str:
    for u in ("B", "K", "M", "G"):
        if n < 1024:
            return f"{n:.0f}{u}"
        n /= 1024
    return f"{n:.0f}T"


def load_plist(path) -> dict:
    """Prefer plistlib; normalize Apple-valid XML without changing its file."""
    with open(path, "rb") as fh:
        raw = fh.read()
    try:
        result = plistlib.loads(raw)
    except Exception:
        try:
            converted = subprocess.run(
                ["/usr/bin/plutil", "-convert", "xml1", "-o", "-", "--", str(path)],
                capture_output=True, check=True, timeout=5,
            )
            result = plistlib.loads(converted.stdout)
        except Exception as exc:
            raise ValueError("plistlib and plutil could not parse plist") from exc
    if not isinstance(result, dict):
        raise ValueError("plist root must be a dictionary")
    return result


def discover() -> list[tuple[str, str]]:
    """(label, path) for every log a user-installed launchd job declares."""
    out, seen = [], set()
    for d in PLIST_DIRS:
        if not os.path.isdir(d):
            continue
        try:
            names = sorted(os.listdir(d))
        except PermissionError:
            continue
        for n in names:
            if not n.endswith(".plist"):
                continue
            path = os.path.join(d, n)
            try:
                pl = load_plist(path)
            except Exception as exc:
                print(f"agent-log-rotate: cannot parse {path}: {exc}", file=sys.stderr)
                continue
            # A valid plist can still carry wrongly typed fields. Skip and
            # report the malformed entry; one bad file never aborts the scan.
            label = pl.get("Label", n[:-6])
            if not isinstance(label, str):
                print(f"agent-log-rotate: skipping {path}: Label is "
                      f"{type(label).__name__}, not a string", file=sys.stderr)
                continue
            if label.startswith(("com.apple.", "org.")):
                continue
            for key in ("StandardOutPath", "StandardErrorPath"):
                p = pl.get(key)
                if p is None:
                    continue
                if not isinstance(p, str):
                    print(f"agent-log-rotate: skipping {key} in {path}: "
                          f"{type(p).__name__}, not a string", file=sys.stderr)
                    continue
                if not p or p == "/dev/null" or p in seen:
                    continue
                seen.add(p)
                out.append((label, p))
    return out


def rotate(path: str, label: str, threshold: int, keep: int,
           dry_run: bool, prune: bool) -> tuple[bool, str]:
    path = os.path.realpath(path)
    try:
        sz = os.path.getsize(path)
    except OSError:
        return False, "missing"
    if sz < threshold:
        return False, f"{human(sz)} under threshold"
    archdir = os.path.join(os.path.dirname(path), ARCHIVE_SUBDIR)
    base = os.path.basename(path)
    if dry_run:
        return True, f"would create a unique archive of {human(sz)} in {archdir} and truncate in place"

    lock_fd = None
    temporary = None
    try:
        # The kernel releases the lock on exit; retain its path for other writers.
        lock_fd = os.open(path + ".rotate.lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return False, "rotation already in progress; live file preserved"
        with open(path, "r+b") as src:
            # The inode lock also serializes hardlink aliases of the same log.
            try:
                fcntl.flock(src.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return False, "rotation already in progress; live file preserved"
            before = os.fstat(src.fileno())
            sz = before.st_size
            if sz < threshold:
                return False, f"{human(sz)} under threshold"
            os.makedirs(archdir, exist_ok=True)
            stamp = time.strftime("%Y%m%dT%H%M%S")
            fd, temporary = tempfile.mkstemp(prefix=f"{base}.{stamp}.", suffix=".partial", dir=archdir)
            dest = temporary[:-len(".partial")] + ".gz"
            # Close the gzip footer and persist every archive byte before publishing.
            with os.fdopen(fd, "wb") as archive:
                with gzip.GzipFile(fileobj=archive, mode="wb", compresslevel=6) as compressed:
                    shutil.copyfileobj(src, compressed, length=1024 * 1024)
                archive.flush()
                os.fsync(archive.fileno())
            os.chown(temporary, before.st_uid, before.st_gid)
            # Exclusive link: even a same-second collision cannot overwrite history.
            os.link(temporary, dest)
            os.unlink(temporary)
            temporary = None
            signature = lambda st: (st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns)
            if signature(os.stat(path)) != signature(before):
                return False, "FAILED: source changed during archival; archive retained, live file preserved"
            # BEST EFFORT, NOT A GUARANTEE. The final check and the truncate are two
            # syscalls, and launchd-owned writers do not honor flock, so a line
            # written between them is lost. Keep the window minimal: the fd check
            # is the last call before truncation. Prefer producer-native rotation.
            if signature(os.fstat(src.fileno())) != signature(before):
                return False, "FAILED: source changed during archival; archive retained, live file preserved"
            src.truncate(0)

        msg = (f"archived {human(sz)} -> {os.path.basename(dest)}, truncated in place "
               "(best-effort: writes racing the final check can be lost)")
        if prune:
            arch = sorted((f for f in os.listdir(archdir)
                           if f.startswith(base + ".") and f.endswith(".gz")), reverse=True)
            for old in arch[keep:]:
                os.unlink(os.path.join(archdir, old))
            if len(arch) > keep:
                msg += f", pruned {len(arch) - keep} old archive(s)"
        return True, msg
    except (OSError, EOFError, ValueError) as exc:
        return False, f"FAILED: {exc}; live source is not truncated before complete archival"
    finally:
        # A failed compress, ownership, link or publish step never leaves a
        # .partial behind; an already published .gz is kept.
        if temporary is not None:
            try:
                os.unlink(temporary)
            except FileNotFoundError:
                pass
        if lock_fd is not None:
            os.close(lock_fd)


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--threshold-mb", type=float, default=25.0,
                    help="rotate logs larger than this (default 25)")
    ap.add_argument("--keep", type=int, default=10,
                    help="archives to keep per log when --prune is used (default 10)")
    ap.add_argument("--prune", action="store_true",
                    help="delete archives beyond --keep. OFF by default; "
                         "preserve logs during debugging.")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--list", action="store_true", help="show sizes and exit")
    args = ap.parse_args()

    logs = discover()
    if args.list:
        rows = []
        for label, p in logs:
            try:
                rows.append((os.path.getsize(p), label, p))
            except OSError:
                pass
        rows.sort(reverse=True)
        total = 0
        for sz, label, p in rows:
            total += sz
            print(f"  {human(sz):>7}  {label}")
            print(f"  {'':>7}    {p}")
        print(f"\n  {len(rows)} logs, {human(total)} total")
        return 0

    threshold = int(args.threshold_mb * 1024 * 1024)
    did = 0
    freed = 0
    failed = False
    for label, p in logs:
        try:
            before = os.path.getsize(p)
        except OSError:
            continue
        changed, msg = rotate(p, label, threshold, args.keep, args.dry_run, args.prune)
        if changed:
            did += 1
            freed += before
            print(f"  {label}: {msg}")
        elif msg.startswith("FAILED:"):
            failed = True
            print(f"  {label}: {msg}", file=sys.stderr)
    verb = "would rotate" if args.dry_run else "rotated"
    print(f"\n  {verb} {did} log(s), {human(freed)} reclaimed from live files")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
