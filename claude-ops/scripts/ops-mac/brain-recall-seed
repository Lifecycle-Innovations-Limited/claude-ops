#!/usr/bin/env python3
"""brain-recall-seed — render fresh standing context for hook-less CLIs.

Codex, Gemini, opencode, aider, amp, and windsurf have no per-prompt hook
surface, so they cannot get live mem0/gbrain injection the way Claude, Cursor,
and Grok do. This writes a compact markdown seed they read at session start
(referenced from ~/AGENTS.md). Can be refreshed by an operator-managed schedule. Fail-safe: on any error the previous seed file is left untouched.
"""
from __future__ import annotations

import datetime
import json
import os
import re
import sys
import time
import tempfile
import urllib.request
from pathlib import Path

# Endpoint and user scope are machine-local, never committed defaults.
CONFIG_PATH = Path(os.getenv("OPS_MAC_RECALL_CONFIG", str(Path.home() / ".config/claude-ops/ops-mac-recall.json")))
CONFIG = {}
CONFIG_ERROR = False
if CONFIG_PATH.exists():
    try:
        CONFIG = json.loads(CONFIG_PATH.read_text(encoding="utf-8"))
        if not isinstance(CONFIG, dict) or any(not isinstance(v, str) for v in CONFIG.values()):
            raise ValueError("configuration values must be strings")
    except (ValueError, OSError):
        CONFIG_ERROR = True
        CONFIG = {}
MEM0_URL = os.getenv("PERSONAL_MEM0_MCP_URL", CONFIG.get("mem0_url", ""))
USER_ID = os.getenv("MEM0_USER_ID", CONFIG.get("user_id", ""))
OUT = Path(os.getenv("RECALL_SEED_PATH", CONFIG.get("seed_path", str(Path.home() / ".local/share/agent-harness/state/recall-seed.md"))))
TIMEOUT = 20.0

QUERIES = [
    "standing preferences rules corrections",
    "current projects decisions infrastructure",
]


def mcp_post(url: str, body: dict, sid: str | None = None) -> tuple[str | None, str]:
    headers = {"Content-Type": "application/json", "Accept": "application/json, text/event-stream"}
    if sid:
        headers["mcp-session-id"] = sid
    req = urllib.request.Request(url, data=json.dumps(body).encode(), headers=headers, method="POST")
    with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
        return resp.headers.get("mcp-session-id") or sid, resp.read().decode(errors="replace")


class RecallError(ValueError):
    """Invalid protocol or explicit tool failure, not an empty search."""


def parse_sse(raw: str, expected_id: int) -> dict:
    candidates = [raw]
    # SSE events may contain multiple data lines and unrelated notifications.
    for event in raw.replace("\r\n", "\n").split("\n\n"):
        data = [line[5:].lstrip() for line in event.splitlines() if line.startswith("data:")]
        if data:
            candidates.append("\n".join(data))
    for candidate in candidates:
        try:
            obj = json.loads(candidate)
        except ValueError:
            continue
        if not isinstance(obj, dict) or obj.get("id") != expected_id:
            continue
        if "error" in obj:
            raise RecallError("JSON-RPC error")
        if not isinstance(obj.get("result"), dict):
            raise RecallError("missing result object")
        return obj
    raise RecallError("missing matching JSON-RPC response")


def mcp_tool(url: str, tool: str, args: dict) -> str:
    sid, initialized = mcp_post(url, {
        "jsonrpc": "2.0", "id": 1, "method": "initialize",
        "params": {"protocolVersion": "2024-11-05", "capabilities": {},
                   "clientInfo": {"name": "brain-recall-seed", "version": "1.0"}}})
    parse_sse(initialized, 1)
    try:
        mcp_post(url, {"jsonrpc": "2.0", "method": "notifications/initialized"}, sid=sid)
    except Exception:
        pass
    _, raw = mcp_post(url, {"jsonrpc": "2.0", "id": 2, "method": "tools/call",
                            "params": {"name": tool, "arguments": args}}, sid=sid)
    result = parse_sse(raw, 2)["result"]
    if result.get("isError"):
        raise RecallError("MCP tool returned isError")
    content = result.get("content")
    if not isinstance(content, list):
        raise RecallError("missing content array")
    texts = [item["text"] for item in content
             if isinstance(item, dict) and isinstance(item.get("text"), str)]
    if not texts:
        raise RecallError("empty tool payload")
    return "\n".join(texts)


def query_with_retry(query: str) -> str:
    for attempt in range(3):
        try:
            return mcp_tool(MEM0_URL, "search_memories",
                            {"query": query, "user_id": USER_ID, "limit": 8})
        except RecallError:
            raise
        except (OSError, TimeoutError):
            if attempt == 2:
                raise
            time.sleep(2 ** attempt)
    raise AssertionError("unreachable")


def extract_memories(raw: str) -> list[str]:
    try:
        data = json.loads(raw)
        if isinstance(data, str):
            data = json.loads(data)
    except ValueError as exc:
        raise RecallError("malformed memory payload") from exc
    if isinstance(data, dict):
        if "results" in data:
            data = data["results"]
        elif "memories" in data:
            data = data["memories"]
        else:
            raise RecallError("missing memory results")
    if not isinstance(data, list):
        raise RecallError("memory results must be an array")
    out = []
    for item in data:
        if not isinstance(item, dict):
            raise RecallError("invalid memory item")
        text = item.get("memory") or item.get("text") or ""
        if not isinstance(text, str):
            raise RecallError("invalid memory text")
        if text:
            out.append(text)
    return out


def main() -> int:
    if CONFIG_ERROR or not MEM0_URL or not USER_ID:
        print("brain-recall-seed: configure endpoint and user scope; previous seed preserved", file=sys.stderr)
        return 2
    seen: set[str] = set()
    lines: list[str] = []
    failed = False
    for q in QUERIES:
        try:
            memories = extract_memories(query_with_retry(q))
        except Exception as exc:
            kind = "timeout" if isinstance(exc, TimeoutError) else "protocol/tool error" if isinstance(exc, RecallError) else "service unavailable"
            print(f"brain-recall-seed: {kind}; previous seed preserved", file=sys.stderr)
            failed = True
            continue
        for m in memories:
            key = re.sub(r"[^a-z0-9]", "", m.lower())[:80]
            if key in seen:
                continue
            seen.add(key)
            lines.append(f"- {m[:300]}")
    if failed:
        return 2
    if not lines:
        # Keep the previous seed rather than writing an empty one.
        print("brain-recall-seed: no results; previous seed left in place", file=sys.stderr)
        return 1

    now = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
    body = (
        f"# Standing context seed (auto-generated {now})\n\n"
        "Freshest personal mem0 standing rules and active-project facts for CLIs\n"
        "without per-prompt recall hooks. For deeper recall, call the mem0 /\n"
        "gbrain MCP tools directly. Do not edit; regenerated 6-hourly.\n\n"
        + "\n".join(lines[:20]) + "\n"
    )
    tmp = None
    try:
        OUT.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=OUT.parent,
                                         prefix=OUT.name + ".", delete=False) as fh:
            tmp = Path(fh.name)
            fh.write(body)
        tmp.replace(OUT)
    except OSError:
        print("brain-recall-seed: seed write failed; previous seed preserved", file=sys.stderr)
        return 2
    finally:
        if tmp is not None:
            tmp.unlink(missing_ok=True)
    print(f"brain-recall-seed: wrote {len(lines[:20])} items to {OUT}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
