#!/usr/bin/env bash
# Pre-commit hook: block commits containing personal data or secrets
# This is a PUBLIC open-source plugin — no user-specific data allowed
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'
FAILED=0

echo "Running pre-commit security checks..."

# Only check added/modified lines in the staged diff (not removals).
#
# Four files are exempt, and only four, by exact path: the scanner, its
# allowlist, and the two negative-control suites. Each has to be able to quote
# the shapes it forbids — a negative control's entire job is to plant a
# forbidden value and prove the gate refuses it. Any other file, including any
# other test, is scanned. The exemption is per path, never per directory:
# tests/ as a whole was already the one place a client id could sit unseen.
EXEMPT_RE='^claude-ops/tests/(test-no-secrets\.sh|known-public-constants\.txt|test-pii-gate-fires\.sh|test-pre-commit-hook-blocks\.sh)$'
DIFF_ADDED=""
while IFS= read -r f; do
  [[ -z "$f" ]] && continue
  if [[ "$f" =~ $EXEMPT_RE ]]; then
    continue
  fi
  hunk=$(git diff --cached -U0 -- "$f" | grep '^+' | grep -v '^+++' || true)
  [[ -n "$hunk" ]] && DIFF_ADDED="$DIFF_ADDED$hunk"$'\n'
done < <(git diff --cached --name-only)

if [[ -z "$DIFF_ADDED" ]]; then
  exit 0
fi

check() {
  local desc="$1" pattern="$2"
  local hits
  hits=$(echo "$DIFF_ADDED" | grep -iE "$pattern" 2>/dev/null | head -3 || true)
  if [[ -n "$hits" ]]; then
    echo -e "${RED}BLOCKED: $desc${NC}"
    echo "$hits" | head -3
    FAILED=1
  fi
}

# === Secrets & tokens (pattern-based, no hardcoded values) ===
check "Shopify admin/app tokens"    'shp(at|ss|pa|ca)_[a-f0-9]{10,}'
check "Slack tokens"                'xox[bpca]-[a-zA-Z0-9]+'
check "GitHub tokens"               'gh[pso]_[A-Za-z0-9]{20,}'
check "AWS access keys"             'AKIA[A-Z0-9]{16}'
check "Generic sk_ secret keys"     '\bsk_[a-zA-Z0-9]{20,}'
check "Generic gsk_ keys"           '\bgsk_[A-Za-z0-9]{20,}'
check "Stripe live keys"            '(sk_live_|pk_live_|rk_live_)[a-zA-Z0-9]+'
check "Google API keys"             'AIza[A-Za-z0-9_-]{35}'
check "Org-prefixed keys (40+ hex)" '\borg_[a-f0-9]{40,}'
check "Bearer tokens in strings"    'Bearer [a-zA-Z0-9_-]{20,}'
check "Base64 JWT-like tokens"      'eyJ[a-zA-Z0-9_-]{50,}'

# === Personal email patterns ===
check "Personal email (webmail)"    '[a-zA-Z0-9._%+-]+@(gmail|yahoo|hotmail|outlook|icloud|proton|hey)\.(com|net|org)'
# Filtered at the point of the check, never afterwards. An amnesty applied to
# $FAILED after the fact clears every OTHER check that already failed, which is
# how a gate stops gating without anyone noticing.
work_mail=$(echo "$DIFF_ADDED" \
  | grep -iE '[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+\.(com|io|ai|dev|co|ltd|limited)' \
  | grep -ivE '@(example|test|localhost|noreply|anthropic)\.' || true)
if [[ -n "$work_mail" ]]; then
  echo -e "${RED}BLOCKED: Non-example work emails${NC}"
  echo "$work_mail" | head -3
  FAILED=1
fi

# Allow @example.com, @test.com, @localhost — filter those out
# === Third-party identifiers (fast staged-diff pass) ===
#
# The full scanner below catches these too, but it sweeps the whole tree and
# reports the first five hits anywhere. This block names the line you just
# staged, which is the difference between a fixable message and a hunt.
#
# The rule is inverted on purpose: an identifier-shaped literal is refused
# unless it is listed in claude-ops/tests/known-public-constants.txt. A denylist
# can only hold the operator's OWN terms, so it structurally cannot protect a
# client's workspace ids — the gap that put ten of them in this public repo.
CONSTANTS="claude-ops/tests/known-public-constants.txt"

uuid_added=$(echo "$DIFF_ADDED" | grep -oE '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}' \
  | grep -viE '^(0{8}-0{4}|1{8}-1{4})-' | sort -u || true)
if [[ -n "$uuid_added" && -f "$CONSTANTS" ]]; then
  uuid_added=$(echo "$uuid_added" | grep -vixFf <(grep -E '^uuid:' "$CONSTANTS" | sed 's/^uuid://') || true)
fi
if [[ -n "$uuid_added" ]]; then
  echo -e "${RED}BLOCKED: undocumented UUID literal in staged lines${NC}"
  echo "$uuid_added" | head -3
  echo "  A third party's id belongs in the environment (docs/LOCAL-PREFS.md)."
  echo "  A public vendor constant belongs in $CONSTANTS, with a reason."
  FAILED=1
fi

# Case-sensitive on purpose: lowercase words are prose, not issue keys.
key_added=$(echo "$DIFF_ADDED" | grep -oE '\b[A-Z][A-Z0-9]{1,9}-[0-9]{1,6}\b' | sort -u || true)
if [[ -n "$key_added" && -f "$CONSTANTS" ]]; then
  key_alt=$(grep -E '^issue-prefix:' "$CONSTANTS" | sed 's/^issue-prefix://' \
    | sed 's/[.[\*^$()+?{|]/\\&/g' | paste -sd '|' -)
  [[ -n "$key_alt" ]] && key_added=$(echo "$key_added" | grep -vE "^($key_alt)-[0-9]{1,6}$" || true)
fi
if [[ -n "$key_added" ]]; then
  echo -e "${RED}BLOCKED: third-party issue-tracker key in staged lines${NC}"
  echo "$key_added" | head -3
  echo "  Use TEAM-<n> and read the real key from \$LINEAR_CLIENT_TEAM_KEY."
  FAILED=1
fi

# Prose may name a zone as an example; code and config may not.
tz_added=$(echo "$DIFF_ADDED" \
  | grep -E '\b(Africa|America|Asia|Atlantic|Australia|Europe|Indian|Pacific)/[A-Za-z_]+' \
  | grep -vE '(OPS_TZ|TZ:-|TIMEZONE|timeZone|Etc/UTC|Europe/Asia)' | head -3 || true)
if [[ -n "$tz_added" ]]; then
  echo -e "${YELLOW}WARNING: IANA timezone in staged lines${NC}"
  echo "$tz_added" | head -3
  echo "  Fine in prose as an example. In code or config, express schedules in"
  echo "  UTC and read the display zone from \$OPS_TZ. The full scanner decides."
fi

# === Hardcoded paths ===
check "macOS home directory"        '/Users/[a-z][a-zA-Z0-9_-]+'
check "Linux home directory"        '/home/[a-z][a-zA-Z0-9_-]+/'

# === Phone numbers (international format) ===
check "Phone numbers"               '\+[0-9]{1,3}[- ]?[0-9]{6,14}'

# === IP addresses (non-localhost, non-example) ===
check "Private/real IP addresses"   '\b(10\.[0-9]+\.[0-9]+\.[0-9]+|172\.(1[6-9]|2[0-9]|3[01])\.[0-9]+\.[0-9]+|192\.168\.[0-9]+\.[0-9]+)\b'

# === Generic sensitive patterns ===
check "password= or secret= values" '(password|secret|api_key|access_token)\s*[=:]\s*["\x27][^"\x27]{8,}'

# === Bare AWS account IDs outside ARN context (account/bucket/aws prose) ===
# Closes the gap where a real 12-digit id in a bucket name (e.g.
# "my-leases-410126241301") or "account <id>" slipped past the ARN-context check.
bare_acct=$(echo "$DIFF_ADDED" | grep -iE '(account|bucket|aws|arn)[^0-9]{0,40}[0-9]{12}([^0-9]|$)|[0-9]{12}[^0-9]{0,40}(account|bucket)' \
  | grep -vE '123456789012|000000000000|111111111111|[0-9]{13}' | head -3 || true)
if [[ -n "$bare_acct" ]]; then
  echo -e "${RED}BLOCKED: bare AWS account ID (account/bucket context)${NC}"
  echo "$bare_acct" | head -3
  FAILED=1
fi

# === Operator identity denylist (OUT-OF-REPO; brand/personal/hostname terms) ===
# A public hook cannot hardcode the operator's own identity terms (that list
# would itself be the PII). Load them from a gitignored / out-of-repo source so
# the hook blocks THIS operator's terms without ever committing them.
#   $OPS_PII_DENYLIST_FILE, ./.pii-denylist, $HOME/.config/claude-ops/pii-denylist.txt
#   or inline $OPS_PII_DENYLIST (comma/space/newline separated).
deny_terms=""
for cand in "${OPS_PII_DENYLIST_FILE:-}" ".pii-denylist" "claude-ops/.pii-denylist" \
            "$HOME/.config/claude-ops/pii-denylist.txt"; do
  [[ -n "$cand" && -f "$cand" ]] && { deny_terms="$(grep -vE '^\s*(#|$)' "$cand" 2>/dev/null || true)"; break; }
done
[[ -n "${OPS_PII_DENYLIST:-}" ]] && deny_terms="$deny_terms"$'\n'"$(echo "$OPS_PII_DENYLIST" | tr ',[:space:]' '\n\n')"
deny_terms=$(echo "$deny_terms" | grep -vE '^\s*$' | sort -u || true)
if [[ -n "$deny_terms" ]]; then
  deny_alt=$(echo "$deny_terms" | sed 's/[.[\*^$()+?{|]/\\&/g' | paste -sd '|' -)
  deny_hits=$(echo "$DIFF_ADDED" | grep -iE "$deny_alt" | grep -vE '(example|placeholder|your[-_]|<[A-Z_]+>)' | head -3 || true)
  if [[ -n "$deny_hits" ]]; then
    echo -e "${RED}BLOCKED: operator identity term from denylist${NC}"
    echo "$deny_hits" | head -3
    FAILED=1
  fi
fi

if [[ $FAILED -eq 1 ]]; then
  echo ""
  echo -e "${RED}Commit blocked — personal or sensitive data detected in a PUBLIC repo.${NC}"
  echo "Use generic placeholders: user@example.com, yourstore.myshopify.com, <YOUR_TOKEN>"
  echo "Bypass with --no-verify (emergency only)."
  exit 1
fi

# Run test suite secrets scanner if available
if [[ -f "claude-ops/tests/test-no-secrets.sh" ]]; then
  (cd claude-ops && bash tests/test-no-secrets.sh > /dev/null 2>&1) || {
    echo -e "${RED}BLOCKED: test-no-secrets.sh failed${NC}"
    exit 1
  }
fi

echo -e "${GREEN}Pre-commit security checks passed${NC}"
