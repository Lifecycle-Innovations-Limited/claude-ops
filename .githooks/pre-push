#!/usr/bin/env bash
# pre-push hook — last stop before anything becomes public.
#
# `commit-msg` only sees the message being written now. It cannot see a commit
# that was made before the hook was installed, one made with --no-verify, one
# that arrived by cherry-pick or rebase, or one written on another machine. The
# push is the moment all of those become public at once, so it is the moment to
# check the whole range.
#
# It also checks the BRANCH NAME, which no other surface looks at and which
# GitHub prints on the PR, in the compare view, and in every notification email.
#
# Deliberately bounded: only the commits actually being pushed, never the whole
# history. A gate that takes a minute gets bypassed.
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
SCAN="$ROOT/claude-ops/bin/ops-pii-scan"
if [[ -z "$ROOT" || ! -x "$SCAN" ]]; then
  echo "WARNING: ops-pii-scan not found — this push was NOT scanned." >&2
  exit 0
fi

ZERO='0000000000000000000000000000000000000000'
STATUS=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -n "${local_sha:-}" ]] || continue
  # A branch deletion pushes nothing new.
  [[ "$local_sha" == "$ZERO" ]] && continue

  if [[ "${remote_sha:-$ZERO}" == "$ZERO" ]]; then
    # New branch: everything not already on some remote. `--not --remotes`
    # rather than a guessed base, so a fork or a stacked branch does not make
    # this scan the entire history.
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi

  # QUOTED. $range can be a multi-word rev-list spec ("<sha> --not --remotes"),
  # and unquoted it splits into separate argv entries, where everything after
  # the first word reaches the option parser as an unknown flag and the scan
  # exits on usage instead of scanning. The splitting belongs inside the
  # collector, which does it deliberately; the call site must not pre-empt it.
  "$SCAN" --commit-range "$range" || STATUS=1

  branch="${local_ref#refs/heads/}"
  [[ "$branch" != "$local_ref" ]] && { "$SCAN" --branch "$branch" || STATUS=1; }
done

exit "$STATUS"
